{
  "name": "blood-sugar-tracking-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && rm -rf dist && tsc -p tsconfig.build.json && node scripts/migrate-on-render-build.mjs",
    "start": "npm run deploy:migrate && node dist/src/server.js",
    "deploy:migrate": "node scripts/deploy-migrate.mjs",
    "db:copy": "node scripts/copy-postgres-data.mjs",
    "password:reset-temp": "npx tsx src/modules/identity/auth/reset-temporary-password-cli.ts",
    "password:reset-non-admins": "npx tsx src/modules/identity/auth/reset-non-admin-passwords-cli.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "permissions:sync": "npx tsx src/modules/identity/rbac/sync-cli.ts",
    "admin:bootstrap": "npx tsx src/modules/identity/rbac/admin-bootstrap-cli.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fontsource/noto-emoji": "^5.2.11",
    "@fontsource/noto-sans-math": "^5.2.8",
    "@fontsource/noto-sans-symbols": "^5.2.11",
    "@fontsource/noto-sans-symbols-2": "^5.2.8",
    "@fontsource/noto-sans-thai": "^5.2.8",
    "@prisma/client": "^5.22.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.8",
    "archiver": "^8.0.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "jose": "^5.9.6",
    "pdfkit": "^0.15.2",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
