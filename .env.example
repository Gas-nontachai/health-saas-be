NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://dev:dev@localhost:5432/blood_sugar
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-to-a-random-jwt-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Optional: only needed while importing existing users from Keycloak.
KEYCLOAK_USER_MIGRATION_ON_DEPLOY=false
KEYCLOAK_USER_MIGRATION_FORCE_EMAIL=false
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=blood-sugar
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

RESET_OTP_SECRET=change-this-to-a-random-secret-at-least-32-characters
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Blood Sugar <no-reply@example.com>"
# SMTP_USER=
# SMTP_PASSWORD=

INITIAL_ADMIN_EMAIL=admin@test.com
INITIAL_ADMIN_PASSWORD=admin1234
INITIAL_ADMIN_BOOTSTRAP_ON_START=true
RBAC_SYNC_ON_START=true
